@page "{id:int}"
@model ShopEase.Pages.AdminProducts.DeleteModel

@{
    ViewData["Title"] = "Delete Product";
}

<section class="py-5">

    <div class="container">

        <div class="mb-5">

            <span class="products-label">
                ADMINISTRATION
            </span>

            <h1 class="products-title">
                Delete Product
            </h1>

            <p class="products-description">
                Remove this product from the ShopEase inventory.
            </p>

        </div>


        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-lg-5 text-center">


                        <!-- IMAGE -->

                        @if (!string.IsNullOrEmpty(Model.Product.ProductImage))
                        {
                            <img src="@Model.Product.ProductImage"
                                 alt="@Model.Product.ProductName"
                                 style="width:140px;
                                        height:140px;
                                        object-fit:contain;
                                        border-radius:16px;
                                        border:1px solid #e5e7eb;
                                        padding:8px;
                                        margin-bottom:20px;" />
                        }
                        else
                        {
                            <i class="bi bi-box-seam"
                               style="font-size:70px;
                                      color:#ed5d7c;">
                            </i>
                        }


                        <!-- PRODUCT NAME -->

                        <h2 class="mb-2">

                            @Model.Product.ProductName

                        </h2>


                        <!-- CATEGORY -->

                        <p class="text-muted mb-1">

                            @Model.Product.Category?.CategoryName

                        </p>


                        <!-- PRICE -->

                        <h4 class="fw-bold mb-4">

                            Rs. @Model.Product.Price.ToString("N2")

                        </h4>


                        <!-- WARNING -->

                        <div class="alert alert-warning text-start">

                            <i class="bi bi-exclamation-triangle"></i>

                            Are you sure you want to delete this product?

                            <br />

                            <small>
                                This action cannot be undone.
                            </small>

                        </div>


                        <!-- BUTTONS -->

                        <form method="post">

                            <div class="d-flex
                                        justify-content-center
                                        gap-3
                                        mt-4">


                                <!-- CANCEL -->

                                <a asp-page="/AdminProducts/Index"
                                   class="btn btn-outline-secondary px-4">

                                    <i class="bi bi-arrow-left"></i>

                                    Cancel

                                </a>


                                <!-- DELETE -->

                                <button type="submit"
                                        class="btn btn-danger px-4">

                                    <i class="bi bi-trash"></i>

                                    Delete Product

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>