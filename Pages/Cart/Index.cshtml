@page
@model ShopEase.Pages.Cart.IndexModel

@{
    ViewData["Title"] = "Cart";
}

<section class="cart-page py-5">

    <div class="container">

        <!-- =========================================
             HEADER
        ========================================== -->

        <div class="mb-5">

            <span class="products-label">
                SHOPEASE
            </span>

            <h1 class="products-title mt-2">
                Your Cart
            </h1>

            <p class="products-description">
                Review your items before checkout.
            </p>

        </div>


        @if (Model.CartItems.Any())
        {
            <div class="row g-4">

                <!-- =========================================
                     CART ITEMS
                ========================================== -->

                <div class="col-lg-8">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-4">


                            @foreach (var item in Model.CartItems)
                            {
                                <div class="cart-item py-4">

                                    <div class="row align-items-center g-3">

                                        <!-- PRODUCT IMAGE -->

                                        <div class="col-md-2">

                                            <div class="cart-item-image">

    @if (!string.IsNullOrEmpty(item.Product?.ProductImage))
    {
        <img src="@item.Product.ProductImage"
             alt="@item.Product.ProductName" />
    }
    else
    {
        <i class="bi bi-box-seam cart-item-placeholder"></i>
    }

</div>

                                        </div>


                                        <!-- PRODUCT INFORMATION -->

                                        <div class="col-md-4">

                                            <span class="cart-product-category">
                                                @item.Product?.Category?.CategoryName
                                            </span>

                                            <h5 class="cart-product-name">
                                                @item.Product?.ProductName
                                            </h5>

                                            <span class="cart-item-price">
                                            Rs. @item.Product.Price
                                            </span>

                                        </div>


                                        <!-- QUANTITY -->

                                        <div class="col-md-3">

                                            <div class="quantity-control">

                                                <!-- MINUS -->

                                                <form method="post"
                                                      asp-page-handler="Decrease">

                                                    <input type="hidden"
                                                           name="productId"
                                                           value="@item.ProductID" />

                                                    <button type="submit"
                                                            class="quantity-btn"
                                                            @(item.Quantity <= 1 ? "disabled" : "")>

                                                        −

                                                    </button>

                                                </form>


                                                <!-- CURRENT QUANTITY -->

                                                <span class="quantity-value">
                                                    @item.Quantity
                                                </span>


                                                <!-- PLUS -->

                                                <form method="post"
                                                      asp-page-handler="Increase">

                                                    <input type="hidden"
                                                           name="productId"
                                                           value="@item.ProductID" />

                                                    <button type="submit"
                                                            class="quantity-btn"
                                                            @(item.Product != null &&
                                                              item.Quantity >= item.Product.StockQuantity
                                                                  ? "disabled"
                                                                  : "")>

                                                        +

                                                    </button>

                                                </form>

                                            </div>

                                        </div>


                                        <!-- SUBTOTAL + REMOVE -->

                                        <div class="col-md-3 text-md-end">

                                            <div class="cart-item-subtotal">

                                                Rs.
                                                @((item.Product?.Price ?? 0) * item.Quantity)
                                                    

                                            </div>


                                            <form method="post"
                                                  asp-page-handler="Remove"
                                                  class="mt-2">

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@item.ProductID" />

                                                <button type="submit"
                                                        class="cart-remove-btn">

                                                    <i class="bi bi-trash"></i>
                                                    Remove

                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- =========================================
                     CART SUMMARY
                ========================================== -->

                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm cart-summary">

                        <div class="card-body p-4">

                            <h4 class="fw-bold mb-4">
                                Order Summary
                            </h4>


                            <div class="d-flex justify-content-between mb-3">

                                <span>
                                    Items
                                </span>

                                <span>
                                    @Model.CartItems.Sum(x => x.Quantity)
                                </span>

                            </div>


                            <hr />


                            <div class="d-flex justify-content-between align-items-center mb-4">

                                <span class="fw-bold">
                                    Total
                                </span>

                                <span class="cart-total">

                                    Rs. @Model.Total.ToString("N2")

                                </span>

                            </div>


                            <!-- CHECKOUT -->

                            <a asp-page="/Checkout/Index"
                               class="btn product-cart-btn w-100">

                                Proceed to Checkout
                                <i class="bi bi-arrow-right"></i>

                            </a>


                            <!-- CONTINUE SHOPPING -->

                            <a asp-page="/Products/Index"
                               class="btn btn-outline-secondary w-100 mt-3">

                                <i class="bi bi-arrow-left"></i>
                                Continue Shopping

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }
        else
        {
            <!-- =========================================
                 EMPTY CART
            ========================================== -->

            <div class="text-center py-5">

                <i class="bi bi-cart-x cart-empty-icon"></i>

                <h3 class="mt-4">
                    Your cart is empty
                </h3>

                <p class="text-muted">
                    Add some products to your cart to get started.
                </p>

                <a asp-page="/Products/Index"
                   class="btn product-cart-btn px-4 mt-3">

                    Browse Products
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>
        }

    </div>

</section>