@page "{id:int}"
@model ShopEase.Pages.AdminProducts.EditModel

@{
    ViewData["Title"] = "Edit Product";
}

<section class="py-5">

    <div class="container">

        <!-- HEADER -->

        <div class="mb-5">

            <span class="products-label">
                ADMINISTRATION
            </span>

            <h1 class="products-title">
                Edit Product
            </h1>

            <p class="products-description">
                Update the product information in the ShopEase inventory.
            </p>

        </div>


        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-lg-5">

                        <form method="post"
                              enctype="multipart/form-data">

                            <input type="hidden"
                                   asp-for="Product.ProductID" />


                            <!-- VALIDATION -->

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-4">
                            </div>


                            <!-- PRODUCT NAME -->

                            <div class="mb-4">

                                <label asp-for="Product.ProductName"
                                       class="form-label fw-semibold">

                                    Product Name

                                </label>

                                <input asp-for="Product.ProductName"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Product.ProductName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- DESCRIPTION -->

                            <div class="mb-4">

                                <label asp-for="Product.Description"
                                       class="form-label fw-semibold">

                                    Description

                                </label>

                                <textarea asp-for="Product.Description"
                                          class="form-control"
                                          rows="4"></textarea>

                                <span asp-validation-for="Product.Description"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- CATEGORY -->

                            <div class="mb-4">

                                <label asp-for="Product.CategoryID"
                                       class="form-label fw-semibold">

                                    Category

                                </label>

                                <select asp-for="Product.CategoryID"
                                        class="form-select form-select-lg">

                                    <option value="0">
                                        -- Select Category --
                                    </option>

                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryID">

                                            @category.CategoryName

                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="Product.CategoryID"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- PRICE + STOCK -->

                            <div class="row">

                                <div class="col-md-6">

                                    <div class="mb-4">

                                        <label asp-for="Product.Price"
                                               class="form-label fw-semibold">

                                            Price (Rs.)

                                        </label>

                                        <input asp-for="Product.Price"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control form-control-lg" />

                                        <span asp-validation-for="Product.Price"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="mb-4">

                                        <label asp-for="Product.StockQuantity"
                                               class="form-label fw-semibold">

                                            Quantity in Stock

                                        </label>

                                        <input asp-for="Product.StockQuantity"
                                               type="number"
                                               min="0"
                                               class="form-control form-control-lg" />

                                        <span asp-validation-for="Product.StockQuantity"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- CURRENT IMAGE -->

                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    Current Product Image
                                </label>

                                <div>

                                    @if (!string.IsNullOrEmpty(Model.Product.ProductImage))
                                    {
                                        <img src="@Model.Product.ProductImage"
                                             alt="@Model.Product.ProductName"
                                             style="width:120px;
                                                    height:120px;
                                                    object-fit:contain;
                                                    border-radius:12px;
                                                    border:1px solid #e5e7eb;
                                                    padding:5px;" />
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            No image uploaded.
                                        </div>
                                    }

                                </div>

                            </div>


                            <!-- NEW IMAGE -->

                            <div class="mb-4">

                                <label asp-for="ImageFile"
                                       class="form-label fw-semibold">

                                    Replace Product Image

                                </label>

                                <input asp-for="ImageFile"
                                       type="file"
                                       class="form-control form-control-lg"
                                       accept="image/*" />

                                <div class="form-text">

                                    Leave empty to keep the current image.

                                </div>

                            </div>


                            <!-- BUTTONS -->

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        mt-5">


                                <!-- BACK -->

                                <a asp-page="/AdminProducts/Index"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-arrow-left"></i>

                                    Back to Products

                                </a>


                                <!-- SAVE -->

                                <button type="submit"
                                        class="btn btn-primary px-4">

                                    <i class="bi bi-check-lg"></i>

                                    Save Changes

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}